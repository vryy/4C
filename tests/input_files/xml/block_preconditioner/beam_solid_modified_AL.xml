<ParameterList name="Teko">
  <!--
  For beam-solid interaction problems in an augmented Lagrangian formulation, these are the recommended
  settings for the modified augmented Lagrangian preconditioner consisting of a lower block triangular
  preconditioner from Teko with a special Schur complement strategy, based on a mass-like interface matrix.
  The preconditioner uses MueLu as multigrid preconditioner for the solid field and Amesos as a direct
  solver on the beam field. The Schur complement is approximated as a diagonal matrix, which is inverted
  directly in the preconditioner itself.
  -->
  <!-- ===========  BLOCK PRECONDITIONER ================ -->
  <!-- Definition of the block preconditioner, which has to be defined under sub-list "Preconditioner",
       which is used by Teko. The single field inverse approximation methods have to be given under
       sub-lists "Inverse<1..n>". -->
  <Parameter name="Inverse Type" type="string" value="Preconditioner"/>
  <ParameterList name="Inverse Factory Library">
    <ParameterList name="Preconditioner">
      <!-- We need to reorder this operator -->
      <Parameter name="Type" type="string" value="Modified Augmented Lagrangian Preconditioner"/>
      <Parameter name="Inverse Type 1" type="string" value="Inverse1"/>
      <Parameter name="Inverse Type 2" type="string" value="Inverse2"/>
    </ParameterList>
    <!-- =========== SINGLE FIELD PRECONDITIONER FOR SOLID ====================== -->
    <ParameterList name="Inverse1">
      <Parameter name="Type" type="string" value="MueLu"/>
      <Parameter name="max levels" type="int" value="10"/>
      <Parameter name="multigrid algorithm" type="string" value="sa"/>
      <Parameter name="transpose: use implicit" type="bool" value="true"/>
      <Parameter name="coarse: max size" type="int" value="1000"/>
      <Parameter name="coarse: type" type="string" value="Umfpack"/>
      <Parameter name="aggregation: type" type="string" value="uncoupled"/>
      <Parameter name="aggregation: drop scheme" type="string" value="classical"/>
      <Parameter name="smoother: type" type="string" value="CHEBYSHEV"/>
      <ParameterList name="smoother: params">
        <Parameter name="chebyshev: degree" type="int" value="3"/>
      </ParameterList>
    </ParameterList>
    <!-- =========== SINGLE FIELD PRECONDITIONER FOR BEAM ======================= -->
    <ParameterList name="Inverse2">
      <Parameter name="Type" type="string" value="Amesos"/>
      <ParameterList name="Amesos Settings">
        <Parameter name="Reindex" type="bool" value="true"/>
      </ParameterList>
    </ParameterList>
  </ParameterList>
</ParameterList>