 namespace Zoltan2{
 
+#ifdef _WIN32
+inline int gettimeofday(struct timeval* tp, void* tzp) {
+    // Note: timezone is generally unused (NULL)
+    (void)tzp;
+    if (tp) {
+        FILETIME ft;
+        GetSystemTimeAsFileTime(&ft);
+        // Convert 100-nanosecond intervals (since Jan 1, 1601) to microseconds (since Jan 1, 1970)
+        unsigned long long intervals = ((unsigned long long)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+        intervals -= 116444736000000000ULL; // Difference between 1601 and 1970
+        tp->tv_sec = (long)(intervals / 10000000ULL);
+        tp->tv_usec = (long)((intervals % 10000000ULL) / 10ULL);
+    }
+    return 0;
+}
+#endif
+
