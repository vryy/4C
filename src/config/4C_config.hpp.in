#ifndef FOUR_C_CONFIG_HPP
#define FOUR_C_CONFIG_HPP

// General definitions that are used throughout the project.
#define FOUR_C_VERSION_FULL "@FOUR_C_VERSION_FULL@"
#define FOUR_C_VERSION_MAJOR @FOUR_C_VERSION_MAJOR@
#define FOUR_C_VERSION_MINOR @FOUR_C_VERSION_MINOR@
#define FOUR_C_VERSION_PATCH @FOUR_C_VERSION_PATCH@

// This flag guards assertions and special checks that are often expensive and should only run when debugging.
#cmakedefine FOUR_C_ENABLE_ASSERTIONS

#cmakedefine FOUR_C_ENABLE_CORE_DUMP

#cmakedefine FOUR_C_ENABLE_FE_TRAPPING

// The project namespace is added via the following two macros. This design allows
// to treat the namespace as invisible within the project.
#define FOUR_C_NAMESPACE_OPEN namespace FourC {
#define FOUR_C_NAMESPACE_CLOSE }

#define FOUR_C_API_NONE

#cmakedefine FOUR_C_VERIFY_INTERFACE_HEADER_SETS

#ifdef FOUR_C_VERIFY_INTERFACE_HEADER_SETS
#define FOUR_C_CORE NONE
#endif

#ifndef FOUR_C_CORE
#error "FOUR_C_CORE is not yet defined. It should have value NONE|IMPORT|EXPORT."
#endif

#cmakedefine FOUR_C_BUILD_SHARED_LIBS

#if defined(FOUR_C_BUILD_SHARED_LIBS)

    #cmakedefine HAVE_VISIBILITY_ATTRIBUTE

    #if defined(HAVE_VISIBILITY_ATTRIBUTE)

        // GCC/Clang attribute to hide symbols from the public ABI of a shared library. This is used
        // to mark symbols with hidden visibility to prevent their export from shared objects.
        #define FOUR_C_HIDDEN __attribute__((visibility("hidden")))

        #define FOUR_C_API_IMPORT __attribute__((visibility("default")))
        #define FOUR_C_API_EXPORT __attribute__((visibility("default")))

    #elif defined(_WIN32)
        #if defined(__MINGW32__) || defined(__MINGW64__)
            #define FOUR_C_HIDDEN __attribute__((visibility("hidden")))
            #define FOUR_C_API_IMPORT __attribute__((visibility("default")))
            #define FOUR_C_API_EXPORT __attribute__((visibility("default")))
        #else
            #define FOUR_C_HIDDEN
            #define FOUR_C_API_IMPORT __declspec(dllimport)
            #define FOUR_C_API_EXPORT __declspec(dllexport)
        #endif
    #else
        #define FOUR_C_HIDDEN
        #define FOUR_C_API_IMPORT
        #define FOUR_C_API_EXPORT
    #endif

#else

    #define FOUR_C_HIDDEN
    #define FOUR_C_API_IMPORT
    #define FOUR_C_API_EXPORT

#endif

#define FOUR_C_APPEND_MACRO(base, suffix) base##suffix
#define FOUR_C_API(MACRO) FOUR_C_APPEND_MACRO(FOUR_C_API_, MACRO)

/// Dependencies
/// The following flags are set when configuring the project with CMake.

@FOUR_C_DEFINES_FOR_EXTERNAL_DEPENDENCIES@

#endif
